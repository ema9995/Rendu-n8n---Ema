
# n8ncli ignored files
.env
n8n/config/sync-state.json
n8n/config/unconfigured-credentials.json
n8n/config/workflow-folders.json
n8n/references/

# n8ncli build cache: duplicates of the workflows keyed by id, regenerated on every push
n8n/config/cache/

# Retired book pipelines, replaced by Chat livre. They still exist on the n8n instance,
# so n8ncli re-pulls them on every pull; these rules keep them out of this repository.
n8n/workflows/Sandbox/RAG Livre.workflow.ts
n8n/workflows/Sandbox/RAG Livre 2.workflow.ts
n8n/workflows/Sandbox/RAG Livre Chunking.workflow.ts
